# Copy to docker/.env and fill in what you need. docker/.env is git-ignored (docker/.gitignore).
# Every line you set reaches the office; leave out what you don't use.

# The office password. Without one, the office makes one up and prints it once in
# `docker compose -f docker/compose.yaml logs office`.
AGENT_OFFICE_PASSWORD=

# The port on this computer (the office is always 4600 inside the container).
# OFFICE_HOST_PORT=4600

# Claude: leave this out and type /login in the first worker's terminal instead (it's kept on the volume).
# ANTHROPIC_API_KEY=

# GitHub: a token signs gh in and lets workers push. Or run `gh auth login` from a desk's shell (B).
# GH_TOKEN=

# Who workers commit as.
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com

# Your time zone, for the office clock and workers' logs.
# TZ=America/New_York

# More of the office's own settings (docs/configuration.md):
# AGENT_OFFICE_MAX_WORKERS=4
# AGENT_OFFICE_BUDGET=20
# AGENT_OFFICE_CITY=Berlin
# AGENT_OFFICE_SKY_CLOCK=real
# AGENT_OFFICE_WEBHOOK=https://hooks.slack.com/services/…
# AGENT_OFFICE_TURN=turn:user:pass@turn.example.com:3478
