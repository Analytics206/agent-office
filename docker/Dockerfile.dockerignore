# Only what the image builds from. BuildKit reads this file for docker/Dockerfile instead of a
# .dockerignore at the repository root, so the root stays as upstream has it.
node_modules
dist
.agent-office
.git
*.log
# The build's `COPY . .` would take anything else in the checkout, so keep local secrets out of the
# image: env files, Claude Code's project settings, keys, the dev password file.
**/.env*
**/.claude
**/.agent-office
**/*.pem
**/*.key
**/id_*
**/pw.txt
